JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRY=3600
ACCESS_TOKEN_SECRET=your-access-token-secret
REFRESH_TOKEN_SECRET=your-refresh-token-secret
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_EMAIL=test@example.com
SMTP_PASSWORD=password

# ── MongoDB ───────────────────────────────────────────────────────────────────
DATABASE_URL=mongodb://mongodb:27017/shop-sphere

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
SERVER_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate secrets:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRY=3600
ACCESS_TOKEN_SECRET=change_this_access_token_secret
REFRESH_TOKEN_SECRET=change_this_refresh_token_secret

# ── SMTP (email) ──────────────────────────────────────────────────────────────
# For dev you can use Mailtrap: https://mailtrap.io (free fake inbox)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_EMAIL=your_mailtrap_user
SMTP_PASSWORD=your_mailtrap_password

# ── Khalti (sandbox payment) ──────────────────────────────────────────────────
# Test keys: https://test-admin.khalti.com
# Test creds → Phone: 9800000000 | MPIN: 1111 | OTP: 987654
KHALTI_SECRET_KEY=your_khalti_test_secret_key

# ── Cloudinary (image uploads) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Frontend (passed to Vite at build time) ───────────────────────────────────
# VITE_ prefix exposes this to the browser via import.meta.env
VITE_API_BASE_URL=http://localhost:3000