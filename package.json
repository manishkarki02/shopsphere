{
	"name": "shop-sphere",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "turbo dev",
		"dev:server": "turbo dev --filter=store-backend",
		"dev:client": "turbo dev --filter=store-frontend",
		"build": "turbo build",
		"lint": "biome check",
