	},
	"devDependencies": {
		"@biomejs/biome": "2.4.13",
		"@types/node": "^25.6.0",
		"turbo": "^2.9.6",
		"typescript": "^6.0.3"
	},
	"packageManager": "pnpm@8.15.1",
	"engines": {
		"node": ">=20.0.0",
		"pnpm": ">=8.0.0"
	}
}
